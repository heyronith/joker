# OpenAI — required for agent council
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini

# Webull market data (prod keys OK — keep real quotes)
WEBULL_APP_KEY=your-prod-app-key
WEBULL_APP_SECRET=your-prod-app-secret
WEBULL_REGION=US
WEBULL_API_ENV=prod
WEBULL_ACCESS_TOKEN=
WEBULL_MARKET_DATA_ENABLED=true
WEBULL_LIVE_TRADING_ENABLED=false

# Webull OpenAPI paper/sandbox trade keys (separate from market data)
WEBULL_TRADE_APP_KEY=your-papertrade-app-key
WEBULL_TRADE_APP_SECRET=your-papertrade-app-secret
WEBULL_TRADE_APP_ID=your-papertrade-app-id
WEBULL_TRADE_API_ENV=sandbox
WEBULL_TRADE_ACCESS_TOKEN=
# After auth against sandbox, paste token above (or run joker with trade env)

WEBULL_PAPER_TRADING_ENABLED=true
# Clear any prod Individual Cash id, then set from: joker broker accounts
WEBULL_PAPER_ACCOUNT_ID=

WEBULL_DEVICE_ID=
WEBULL_TRADE_PIN=

JOKER_CONFIG=config/paper.yaml
JOKER_DATA_DIR=data
JOKER_LOG_LEVEL=INFO
